# Copy to .env and fill in. .env is gitignored and never committed.

# Local infra (docker compose defaults)
# Host port 5434 because a native PostgreSQL service owns 5432 on this machine.
META_DB_URL=postgresql://postgres:dev@localhost:5434/schemasync
DRYRUN_DB_URL=postgresql://postgres:dev@localhost:5433/postgres
REDIS_URL=redis://localhost:6379

# MongoDB Atlas (external M0 cluster)
ATLAS_URI=

# Sponsor APIs
BACKBOARD_API_KEY=
COMPOSIO_API_KEY=
HUAWEI_API_KEY=

# GitHub webhook (sandbox repo -> gateway via cloudflared)
GITHUB_WEBHOOK_SECRET=
